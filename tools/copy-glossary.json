  "_variantsNote": "Pairs are [preferred, other]. 'licence' (noun) vs 'license' (verb) and 'centre' vs 'center' are not enforced automatically because product names (e.g. 'Communication Center', 'Microsoft License') may legitimately use either. Add them here if you decide.",
  "preferredTerms": [
    {
      "avoid": [
        "Log Out",
        "Logout",
        "Log out",
        "Sign Out"
      ],
      "use": "Sign out"
    },
    {
      "avoid": [
        "Log In",
        "Login"
      ],
      "use": "Sign in",
      "only": "button"
    },
    {
      "avoid": [
        "Reqs"
      ],
      "use": "Requirements"
    },
    {
      "avoid": [
        "Kindly"
      ],
      "use": "Please"
    },
    {
      "avoid": [
        "Pls",
        "Plz"
      ],
      "use": "Please"
    },
    {
      "avoid": [
        "Click here"
      ],
      "use": "a link that names the destination"
    },
    {
      "avoid": [
        "Something went wrong",
        "An error occurred",
        "Error occurred",
        "Unknown error"
      ],
      "use": "say what failed and what to do, e.g. \"Couldn't save the vehicle. Check the registration number and try again.\""
    },
    {
      "avoid": [
        "Are you sure?"
      ],
      "use": "name the record and the consequence, e.g. \"Delete vehicle MH 12 AB 1234? Its trips stay in reports.\""
    },
    {
      "avoid": [
        "Submit"
      ],
      "use": "the action, e.g. \"Create ticket\", \"Send for approval\"",
      "only": "button"
    },
    {
      "avoid": [
        "OK",
        "Ok"
      ],
      "use": "the action, e.g. \"Done\", \"Delete\"",
      "only": "button"
    },
    {
      "avoid": [
        "Vendor / Provider Master",
        "Vendor/Provider Master"
      ],
      "use": "Vendors"
    },
    {
      "avoid": [
        "Trash Data"
      ],
      "use": "Trash"
    },
    {
      "avoid": [
        "No Data",
        "No data found",
        "No Records Found",
        "No records found"
      ],
      "use": "say what's missing and what to do, e.g. \"No tasks match these filters\""
    },
    {
      "avoid": [
        "Paytment"
      ],
      "use": "Payment"
    }
  ],
